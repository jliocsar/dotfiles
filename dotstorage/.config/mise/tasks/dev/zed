#!/usr/bin/env bash
#MISE description="Install or update Zed editor"
#MISE dir="/tmp"
# Not a mise tool: the github backend fails artifact attestation verification,
# and the vendor installer also lands the .desktop entry with absolute paths.
set -euo pipefail

# Real path, not `command -v`: ~/.local/bin isn't on PATH in a non-interactive shell.
zed_bin="$HOME/.local/bin/zed"
latest=$(curl -fsSL https://api.github.com/repos/zed-industries/zed/releases/latest | jq -re '.tag_name | ltrimstr("v")')
installed=$([[ -x "$zed_bin" ]] && "$zed_bin" --version | awk '{print $2}' || true)

if [[ "$installed" == "$latest" ]]; then
  echo "[dev] zed $latest already installed"
  exit 0
fi

# The installer replaces ~/.local/zed.app in place, so it doubles as the updater.
echo "[dev] Installing zed $latest${installed:+ (was $installed)}"
curl -fsSL https://zed.dev/install.sh | sh
