#!/usr/bin/env bash
#MISE description="Install or update Obsidian"
#MISE dir="/tmp"
set -euo pipefail

# /releases/latest can point at a release whose assets are still uploading,
# so walk the list and take the newest one that actually has the .deb.
obsidian_url=$(curl -fsSL https://api.github.com/repos/obsidianmd/obsidian-releases/releases \
  | jq -re 'first(.[].assets[] | select(.name | endswith("_amd64.deb"))) | .browser_download_url')
latest=$(basename "$obsidian_url" | sed -E 's/^obsidian_(.+)_amd64\.deb$/\1/')
installed=$(dpkg-query -W -f='${Version}' obsidian 2>/dev/null || true)

if [[ "$installed" == "$latest" ]]; then
  echo "[dev] obsidian $latest already installed"
  exit 0
fi

echo "[dev] Installing obsidian $latest${installed:+ (was $installed)}"
trap 'rm -f ./obsidian.deb' EXIT
wget -O obsidian.deb "$obsidian_url"
sudo dpkg -i ./obsidian.deb
