#!/usr/bin/env bash
#MISE description="Install Hex (voice dictation)"
#MISE dir="/tmp"
set -euo pipefail

echo "[dev] Installing hex"
trap 'rm -f /tmp/hex.deb' EXIT
curl -fLo /tmp/hex.deb https://anoma.ly/hex/download/linux-x64-deb
# apt (not dpkg -i) so it pulls libvulkan1 & friends if missing
sudo apt-get install -y /tmp/hex.deb
