keybind = ctrl+shift+k=toggle_tab_overview
keybind = ctrl+enter=unbind

# The `theme` command rewrites the `theme` and `background` lines below from
# its family + mode; flip `theme_family` in ~/.local/bin/theme, not these.
# Delta One themes live in ./themes/, Zenbones ships with ghostty.
theme = light:Delta One Light,dark:Delta One Dark
background = fafafa
background-opacity = 0.92

gtk-titlebar = false
gtk-titlebar-style = native
window-show-tab-bar = never
window-padding-x = 8
window-padding-y = 8

app-notifications = no-clipboard-copy
desktop-notifications = false
clipboard-read = allow
clipboard-write = allow

#font-family = Ioskeley Mono
font-family = Martian Mono
#font-family = CozetteVector
#font-family = Comic Mono
font-size = 9
font-style = SemiBold
font-style-bold = ExtraBold
font-style-italic = SemiBold Italic
font-style-bold-italic = ExtraBold Italic
font-feature = -calt
font-feature = -liga
font-feature = -dlig
adjust-cell-width = 0
adjust-cell-height = 4