#!/usr/bin/env node
// launches slack and injects a custom UI font over CDP.
// uses --remote-debugging-pipe (fds 3/4) so only this process can talk to
// devtools: no TCP port is opened. exits when slack exits.
//
// also injects ~/.config/slack-custom/custom.css (SLACK_CUSTOM_CSS to override)
// and live-reloads it on save. mono rules get --mono-bump (px) added to their
// font-size; set it in custom.css, e.g. :root { --mono-bump: 1px; }
//
// env: SLACK_FONT, SLACK_MONO_FONT, SLACK_BIN, SLACK_CUSTOM_CSS, SLACK_FONT_LOG (debug log path)

import { spawn } from 'node:child_process';
import { appendFileSync, readFileSync, watchFile } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const FONT = process.env.SLACK_FONT || 'SF Pro';
const MONO = process.env.SLACK_MONO_FONT || 'Ioskeley Mono, Slack-Roboto-Mono, Menlo, monospace';
const SLACK = process.env.SLACK_BIN || '/usr/bin/slack';
const LOG = process.env.SLACK_FONT_LOG;
const log = (...a) => LOG && appendFileSync(LOG, `[${new Date().toISOString()}] ${a.join(' ')}\n`);

const CUSTOM_CSS = process.env.SLACK_CUSTOM_CSS || join(homedir(), '.config/slack-custom/custom.css');

const fontCss = `
:root, body { --font-family-default: "${FONT}" !important; }
body { font-family: "${FONT}", sans-serif !important; }
pre, code, pre *, code *, kbd { font-family: ${MONO} !important; }
`;

const readCustomCss = () => {
  try { return readFileSync(CUSTOM_CSS, 'utf8'); } catch { return ''; }
};

// the page keeps the css on window.__customCss so a re-injection swaps it in
// place instead of stacking another timer.
//
// slack's own mono rules live in cascade layers, and layered !important beats
// anything unlayered we append. so mono rules are patched in place via cssom:
// font-family -> MONO, px font-size -> original + --mono-bump.
const buildSource = () => `(() => {
  window.__customCss = ${JSON.stringify(fontCss + '\n' + readCustomCss())};
  window.__monoFont = ${JSON.stringify(MONO)};
  const id = '__custom_css';
  const isMono = (ff) => /monospace|monaco|menlo|courier/i.test(ff);
  const patched = (window.__monoPatched ||= []);
  const seenStyles = (window.__monoSeenStyles ||= new WeakSet());
  const sheetSizes = (window.__monoSheetSizes ||= new WeakMap());
  const bump = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--mono-bump')) || 0;
  const setSize = (p, b) => p.style.setProperty('font-size', (p.orig + b) + 'px', p.prio);
  const patchStyle = (style) => {
    if (seenStyles.has(style)) return;
    seenStyles.add(style);
    if (style.getPropertyValue('--font-family-monospace')) {
      style.setProperty('--font-family-monospace', window.__monoFont, style.getPropertyPriority('--font-family-monospace'));
    }
    const ff = style.getPropertyValue('font-family');
    if (!ff || !isMono(ff)) return;
    style.setProperty('font-family', window.__monoFont, style.getPropertyPriority('font-family'));
    const fs = style.getPropertyValue('font-size');
    if (/^[\\d.]+px$/.test(fs)) {
      const p = { style, orig: parseFloat(fs), prio: style.getPropertyPriority('font-size') };
      patched.push(p);
      setSize(p, window.__monoBumpApplied || 0);
    }
  };
  const walk = (rules) => { for (const r of rules) { if (r.style) patchStyle(r.style); if (r.cssRules) walk(r.cssRules); } };
  const patchSheets = () => {
    for (const sheet of document.styleSheets) {
      if (sheet.ownerNode && sheet.ownerNode.id === id) continue;
      let rules;
      try { rules = sheet.cssRules; } catch { continue; }
      if (sheetSizes.get(sheet) === rules.length) continue;
      sheetSizes.set(sheet, rules.length);
      walk(rules);
    }
    const b = bump();
    if (b !== (window.__monoBumpApplied || 0)) {
      window.__monoBumpApplied = b;
      for (const p of patched) setSize(p, b);
    }
  };
  const apply = () => {
    if (!document.documentElement) return;
    let s = document.getElementById(id);
    if (!s) {
      s = document.createElement('style');
      s.id = id;
      (document.head || document.documentElement).appendChild(s);
    } else if (s.parentNode.lastElementChild !== s) {
      s.parentNode.appendChild(s);
    }
    if (s.textContent !== window.__customCss) s.textContent = window.__customCss;
    try { patchSheets(); } catch {}
  };
  window.__applyCustomCss = apply;
  apply();
  // electron menu accelerators don't fire on wayland with the menu bar hidden,
  // so handle the devtools shortcut in the page. slack resets its
  // devToolsEnabled setting from a server flag on every load, so flip it back on
  // right before toggling (both go over the same ipc channel, in order).
  if (!window.__customDevtoolsKeys) {
    window.__customDevtoolsKeys = true;
    window.addEventListener('keydown', (e) => {
      const combo = e.key === 'F12' || (e.ctrlKey && e.altKey && !e.shiftKey && e.code === 'KeyI');
      const app = window.desktop?.app;
      if (!combo || !app?.toggleDevTools) return;
      e.preventDefault();
      e.stopPropagation();
      if (!app.getPreference?.('devToolsEnabled')) app.setPreference?.({ name: 'devToolsEnabled', value: true });
      setTimeout(() => app.toggleDevTools(), 50);
    }, true);
  }
  if (!window.__customCssTimer) {
    document.addEventListener('DOMContentLoaded', () => window.__applyCustomCss());
    window.addEventListener('load', () => window.__applyCustomCss());
    window.__customCssTimer = setInterval(() => window.__applyCustomCss(), 3000);
  }
})()`;
let source = buildSource();

const child = spawn(SLACK, ['--remote-debugging-pipe', ...process.argv.slice(2)], {
  stdio: ['ignore', 'ignore', 'ignore', 'pipe', 'pipe'],
});
const toSlack = child.stdio[3];
const fromSlack = child.stdio[4];
toSlack.on('error', (e) => log('write error', e.message));
fromSlack.on('error', (e) => log('read error', e.message));

let nextId = 0;
const pending = new Map();
const send = (method, params = {}, sessionId) =>
  new Promise((resolve) => {
    const id = ++nextId;
    pending.set(id, resolve);
    toSlack.write(JSON.stringify({ id, method, params, ...(sessionId && { sessionId }) }) + '\0');
  });

const attached = new Set();
const sessions = new Map(); // targetId -> { sessionId, scriptId }
async function inject(target) {
  attached.add(target.targetId);
  const { result, error } = await send('Target.attachToTarget', { targetId: target.targetId, flatten: true });
  if (error) return log('attach failed', target.url, error.message);
  const s = result.sessionId;
  await send('Page.enable', {}, s);
  const added = await send('Page.addScriptToEvaluateOnNewDocument', { source }, s);
  sessions.set(target.targetId, { sessionId: s, scriptId: added.result?.identifier });
  await send('Runtime.evaluate', { expression: source }, s);
  await send('Runtime.runIfWaitingForDebugger', {}, s);
  log('injected', target.url);
  if (LOG) {
    setTimeout(async () => {
      const r = await send('Runtime.evaluate', { expression: 'getComputedStyle(document.body).fontFamily', returnByValue: true }, s);
      log('body font', target.url, r.result?.result?.value);
    }, 15000);
  }
}

function handle(msg) {
  if (msg.id && pending.has(msg.id)) {
    pending.get(msg.id)(msg);
    pending.delete(msg.id);
  } else if (msg.method === 'Target.targetCreated') {
    const t = msg.params.targetInfo;
    if (t.type === 'page' && !attached.has(t.targetId)) inject(t).catch((e) => log('inject error', e.message));
  } else if (msg.method === 'Target.targetDestroyed') {
    attached.delete(msg.params.targetId);
    sessions.delete(msg.params.targetId);
  }
}

let buf = '';
fromSlack.setEncoding('utf8');
fromSlack.on('data', (chunk) => {
  buf += chunk;
  let n;
  while ((n = buf.indexOf('\0')) !== -1) {
    const raw = buf.slice(0, n);
    buf = buf.slice(n + 1);
    try { handle(JSON.parse(raw)); } catch (e) { log('bad message', e.message); }
  }
});

child.on('error', (e) => { console.error(`slack-font-inject: ${e.message}`); process.exit(1); });
child.on('exit', (code) => process.exit(code ?? 0));
for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, () => child.kill(sig));

send('Target.setDiscoverTargets', { discover: true }).then((r) => log('discover', r.error ? r.error.message : 'ok'));

// live reload: polling follows symlinks and survives editors that replace the file
watchFile(CUSTOM_CSS, { interval: 1000 }, async () => {
  source = buildSource();
  for (const entry of sessions.values()) {
    const { sessionId } = entry;
    if (entry.scriptId) await send('Page.removeScriptToEvaluateOnNewDocument', { identifier: entry.scriptId }, sessionId);
    const added = await send('Page.addScriptToEvaluateOnNewDocument', { source }, sessionId);
    entry.scriptId = added.result?.identifier;
    await send('Runtime.evaluate', { expression: source }, sessionId);
  }
  log('reloaded', CUSTOM_CSS);
  if (LOG) {
    for (const { sessionId } of sessions.values()) {
      const r = await send('Runtime.evaluate', { expression: 'getComputedStyle(document.body).fontFamily', returnByValue: true }, sessionId);
      log('body font after reload', r.result?.result?.value);
    }
  }
});
