#!/usr/bin/env bash
# theme — the definitive dark/light switch for this machine.
#
# Writes the canonical mode to two signals, in order:
#   1. $XDG_STATE_HOME/theme/mode  — read by nvim (fs_event), tmux (source-file)
#      and the Claude Code statusline (read on its next render)
#   2. gsettings color-scheme      — followed live by ghostty and every GTK app
# Then pushes the palette into any running tmux server. ghostty and nvim pick
# the change up on their own, so nothing to push there.
#
# This command is the single entry point: an OS-panel or auto day/night change
# is *not* mirrored back into the local signals, so always flip via `theme`.
#
# Usage: theme            print current mode
#        theme toggle     flip dark <-> light
#        theme dark|light set explicitly
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
state_file="$state_dir/mode"
tmux_palette_dir="$HOME/.config/tmux"
# Claude Code reads its UI theme from settings.json; both configs (personal +
# work) get the matching custom Delta One theme on every mode change.
claude_settings=("$HOME/.claude/settings.json" "$HOME/.claude-work/settings.json")
# ghostty picks its palette from `theme = light:...,dark:...`, but the explicit
# `background` override is a single value, so the config carries both lines and
# we comment out the one that doesn't match the mode.
ghostty_config="$HOME/.config/ghostty/config.ghostty"
# Delta One: the editor/thread background of Delta's bundled theme.
ghostty_background_dark=191c1f
#ghostty_background_dark=0c0b0a zenbones
ghostty_background_light=fafafa
# hunk keeps one custom theme per config file, so the palette below the marker
# is regenerated from ~/.config/hunk/<family>-<mode>.toml on every mode change.
hunk_config_dir="$HOME/.config/hunk"
hunk_palette_marker='# >>> theme palette'
hunk_palette_family=delta-one
#hunk_palette_family=zenbones
# One themes ship with hunk; only the `theme = ` line needs swapping for them.
#hunk_config="$HOME/.config/hunk/config.toml"
#hunk_theme_dark=one-dark-pro
#hunk_theme_light=one-light
# Pantheon reads only `picture-uri`, not the light/dark pair other GNOME shells
# use, so the wallpaper is swapped by hand on every mode change.
wallpaper_dark="/usr/share/backgrounds/odin-dark.jpg"
wallpaper_light="/usr/share/backgrounds/A Large Body of Water Surrounded By Mountains.jpg"

# Keep the prefs above the marker, replace everything below it with the palette
# for this mode. hunk reads its config at startup, so open sessions keep theirs.
apply_hunk_theme() {
    local mode="$1"
    local config="$hunk_config_dir/config.toml"
    local palette="$hunk_config_dir/$hunk_palette_family-$mode.toml"
    [[ -f "$config" && -f "$palette" ]] || return 0

    local tmp="$config.theme.tmp"
    awk -v marker="$hunk_palette_marker" \
        'index($0, marker) == 1 { exit } { print }' "$config" >"$tmp"
    printf '%s — regenerated by the `theme` command, edit\n# %s instead.\n' \
        "$hunk_palette_marker" "$hunk_config_dir/$hunk_palette_family-<mode>.toml" >>"$tmp"
    cat "$palette" >>"$tmp"
    # Redirect rather than mv: $config is a symlink into dotstorage.
    cat "$tmp" >"$config"
    rm -f "$tmp"
}

# Leave the current mode's background uncommented and comment out the other,
# then ask the running ghostty to reload (same as the ctrl+shift+, keybind).
apply_ghostty_background() {
    local mode="$1" wanted="$ghostty_background_dark" other="$ghostty_background_light"
    [[ -f "$ghostty_config" ]] || return 0
    if [[ "$mode" == light ]]; then
        wanted="$ghostty_background_light"
        other="$ghostty_background_dark"
    fi
    # --follow-symlinks so the dotstorage link survives the rewrite.
    sed -i --follow-symlinks \
        -e "s|^#*[[:space:]]*background = $wanted\$|background = $wanted|" \
        -e "s|^#*[[:space:]]*background = $other\$|#background = $other|" \
        "$ghostty_config"

    # ghostty has no `+reload-config` CLI action, but it exports the same
    # action over D-Bus. Fails harmlessly when no ghostty is running.
    gdbus call --session \
        --dest com.mitchellh.ghostty \
        --object-path /com/mitchellh/ghostty \
        --method org.gtk.Actions.Activate reload-config "[]" "{}" \
        >/dev/null 2>&1 || true
}

# Swap the desktop background. Both keys are written so that GTK apps reading
# the dark variant agree with Pantheon, which only ever reads `picture-uri`.
apply_wallpaper() {
    local mode="$1" wallpaper="$wallpaper_dark"
    [[ "$mode" == light ]] && wallpaper="$wallpaper_light"
    [[ -f "$wallpaper" ]] || return 0

    # Spaces are the only character these filenames carry that a URI can't.
    local uri="file://${wallpaper// /%20}"
    gsettings set org.gnome.desktop.background picture-uri "$uri" 2>/dev/null || true
    gsettings set org.gnome.desktop.background picture-uri-dark "$uri" 2>/dev/null || true
}

# Point every Claude Code config at the custom Delta One theme for this mode.
# Running sessions pick it up on their next settings read; no reload needed.
apply_claude_theme() {
    local mode="$1" theme="custom:one-${1}-theme" file
    #local mode="$1" theme="custom:${1}-theme" file # zenbones
    command -v jq >/dev/null 2>&1 || return 0
    for file in "${claude_settings[@]}"; do
        [[ -f "$file" ]] || continue
        local tmp="$file.theme.tmp"
        if jq --arg t "$theme" '.theme = $t' "$file" >"$tmp" 2>/dev/null; then
            mv -f "$tmp" "$file"
        else
            rm -f "$tmp"
        fi
    done
}

current_mode() {
    if [[ -r "$state_file" ]]; then
        cat "$state_file"
    else
        # Fall back to the OS preference the first time, before we've toggled.
        case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
            *light*) echo light ;;
            *) echo dark ;;
        esac
    fi
}

apply_mode() {
    local mode="$1"

    mkdir -p "$state_dir"
    # Atomic write so nvim's fs_event sees a single rename, not a truncate.
    printf '%s\n' "$mode" >"$state_file.tmp"
    mv -f "$state_file.tmp" "$state_file"

    local scheme=prefer-dark
    [[ "$mode" == light ]] && scheme=prefer-light
    gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2>/dev/null || true

    # tmux is parked in favour of herdr; re-enable to push the palette again.
    #if command -v tmux >/dev/null 2>&1 && tmux has-session 2>/dev/null; then
    #    tmux source-file "$tmux_palette_dir/zenbones-$mode.conf" 2>/dev/null || true
    #    #tmux source-file "$tmux_palette_dir/onedark-$mode.conf" 2>/dev/null || true
    #fi

    apply_wallpaper "$mode"
    apply_ghostty_background "$mode"
    apply_hunk_theme "$mode"
    apply_claude_theme "$mode"
}

case "${1:-}" in
    "") current_mode ;;
    dark | light) apply_mode "$1" ;;
    toggle) [[ "$(current_mode)" == dark ]] && apply_mode light || apply_mode dark ;;
    *)
        echo "Usage: theme [toggle|dark|light]" >&2
        exit 1
        ;;
esac
