#!/usr/bin/env bash
# theme — the definitive dark/light switch for this machine.
#
# Two axes:
#   family — which palette, delta-one or zenbones. Set below, rarely changes.
#   mode   — dark or light. Flipped by this command.
# Every themed app keeps one theme per <family>-<mode>; this script points each
# app at the right one.
#
# Built for the niri session. Writes the canonical state first:
#   1. $XDG_STATE_HOME/theme/{mode,family} — read live by nvim (mode, fs_event)
#      and quickshell (both)
#   2. gsettings color-scheme — xdg-desktop-portal-gnome serves it to every app
#      that asks the portal (ghostty, GTK4, Chrome); herdr follows ghostty
# then rewrites the per-app configs below. niri runs `theme apply` at startup,
# so a fresh session comes up with the last mode's wallpaper and colors.
#
# Not driven from here, since their configs can't branch on a variable: nvim's
# plugin choice (`enabled` in plugin_spec/onedark.lua vs lush.lua, plus
# install.colorscheme in init.lua) and herdr's [theme] block. Flip those by
# hand together with `theme_family`, then run `theme apply`.
#
# This command is the single entry point: an OS-panel or auto day/night change
# is *not* mirrored back into the local signals, so always flip via `theme`.
#
# Usage: theme            print current mode
#        theme toggle     flip dark <-> light
#        theme dark|light set explicitly
#        theme apply      re-apply the current mode (after changing the family)
set -euo pipefail

#theme_family=zenbones
theme_family=delta-one

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
# Claude Code reads its UI theme from settings.json; both configs (personal +
# work) share ~/.claude/themes/<family>-<mode>.json.
claude_settings=("$HOME/.claude/settings.json" "$HOME/.claude-work/settings.json")
# pi takes a "light/dark" pair of ~/.pi/agent/themes/<family>-<mode>.json.
pi_settings="$HOME/.pi/agent/settings.json"
ghostty_config="$HOME/.config/ghostty/config.ghostty"
# hunk can't include another file, so its config keeps the prefs
# above this marker and gets the <family>-<mode> palette pasted below it.
palette_marker='# >>> theme palette'
# swaybg draws niri's wallpaper (niri has none of its own). The light image is
# the dark one with lightness flipped and hue kept:
#   convert macos-muted-05.png -negate -modulate 100,100,0 -evaluate add 4% macos-muted-05-light.png
wallpaper_dark="$HOME/Pictures/Wallpapers/macos-muted-05.png"
wallpaper_light="$HOME/Pictures/Wallpapers/macos-muted-05-light.png"

# Atomic write so fs watchers (nvim, quickshell) see a single rename, not a truncate.
write_state() {
    local name="$1" value="$2"
    mkdir -p "$state_dir"
    printf '%s\n' "$value" >"$state_dir/$name.tmp"
    mv -f "$state_dir/$name.tmp" "$state_dir/$name"
}

# Keep everything above the marker in $config, replace everything below it
# with $palette. hunk reads its config at startup, so open sessions keep theirs.
replace_palette() {
    local config="$1" palette="$2"
    [[ -f "$config" && -f "$palette" ]] || return 0

    local tmp="$config.theme.tmp"
    awk -v marker="$palette_marker" \
        'index($0, marker) == 1 { exit } { print }' "$config" >"$tmp"
    printf '%s — regenerated by the `theme` command, edit\n# %s instead.\n' \
        "$palette_marker" "$palette" >>"$tmp"
    cat "$palette" >>"$tmp"
    # Redirect rather than mv: $config is a symlink into dotstorage.
    cat "$tmp" >"$config"
    rm -f "$tmp"
}

# Set one top-level string in a JSON settings file. Writes through the path
# rather than mv'ing over it, so a dotstorage symlink survives.
set_json_string() {
    local file="$1" key="$2" value="$3"
    [[ -f "$file" ]] || return 0

    local tmp="$file.theme.tmp"
    if jq --arg key "$key" --arg value "$value" '.[$key] = $value' "$file" >"$tmp" 2>/dev/null; then
        cat "$tmp" >"$file"
    fi
    rm -f "$tmp"
}

# ghostty picks its palette from `theme = light:...,dark:...`, but the explicit
# `background` override is a single value, so both lines are rewritten here.
# Then ask the running ghostty to reload (same as the ctrl+shift+, keybind).
apply_ghostty_theme() {
    local family="$1" mode="$2"
    [[ -f "$ghostty_config" ]] || return 0

    local theme_name background
    case "$family" in
        zenbones)
            theme_name=Zenbones
            # Deeper than zenbones' own #1c1917, on purpose.
            background=0c0b0a
            ;;
        *)
            # Custom theme files in ~/.config/ghostty/themes/. Background is
            # Delta's editor bg, not Zed's terminal bg.
            theme_name="Delta One"
            background=191c1f
            ;;
    esac
    [[ "$mode" == light ]] && background=fafafa

    # --follow-symlinks so the dotstorage link survives the rewrite.
    sed -i --follow-symlinks \
        -e "s|^theme = .*|theme = light:$theme_name Light,dark:$theme_name Dark|" \
        -e "s|^background = .*|background = $background|" \
        "$ghostty_config"

    # ghostty has no `+reload-config` CLI action, but it exports the same
    # action over D-Bus. Fails harmlessly when no ghostty is running.
    gdbus call --session \
        --dest com.mitchellh.ghostty \
        --object-path /com/mitchellh/ghostty \
        --method org.gtk.Actions.Activate reload-config "[]" "{}" \
        >/dev/null 2>&1 || true
}

# niri includes colors.kdl (optional=true) and live-reloads when it changes.
# colors.kdl is generated and untracked, so a rename is fine here.
apply_niri_colors() {
    local palette="$HOME/.config/niri/$1-$2.kdl" colors="$HOME/.config/niri/colors.kdl"
    [[ -f "$palette" ]] || return 0
    cp -f "$palette" "$colors.tmp"
    mv -f "$colors.tmp" "$colors"
}

# (Re)start swaybg with this mode's image. Skipped outside a niri session, and
# when that exact image is already up (no flicker on a same-image flip).
apply_wallpaper() {
    local mode="$1" wallpaper="$wallpaper_dark"
    [[ "$mode" == light ]] && wallpaper="$wallpaper_light"
    [[ -n "${NIRI_SOCKET:-}" && -f "$wallpaper" ]] || return 0
    command -v swaybg >/dev/null 2>&1 || return 0
    pgrep -fx "swaybg -m fill -i $wallpaper" >/dev/null 2>&1 && return 0

    pkill -x swaybg 2>/dev/null || true
    setsid swaybg -m fill -i "$wallpaper" >/dev/null 2>&1 </dev/null &
}

current_mode() {
    if [[ -r "$state_dir/mode" ]]; then
        cat "$state_dir/mode"
    else
        # Fall back to the OS preference the first time, before we've toggled.
        case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
            *light*) echo light ;;
            *) echo dark ;;
        esac
    fi
}

apply_mode() {
    local mode="$1" family="$theme_family"

    # Family first, so a watcher woken by the mode change reads the new pair.
    write_state family "$family"
    write_state mode "$mode"

    local scheme=prefer-dark
    [[ "$mode" == light ]] && scheme=prefer-light
    gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2>/dev/null || true

    apply_wallpaper "$mode"
    apply_ghostty_theme "$family" "$mode"
    apply_niri_colors "$family" "$mode"
    replace_palette "$HOME/.config/hunk/config.toml" "$HOME/.config/hunk/$family-$mode.toml"

    # Running Claude/pi sessions pick these up on their next settings read.
    if command -v jq >/dev/null 2>&1; then
        local file
        for file in "${claude_settings[@]}"; do
            set_json_string "$file" theme "custom:$family-$mode"
        done
        set_json_string "$pi_settings" theme "$family-light/$family-dark"
    fi
}

case "${1:-}" in
    "") current_mode ;;
    dark | light) apply_mode "$1" ;;
    apply) apply_mode "$(current_mode)" ;;
    toggle) [[ "$(current_mode)" == dark ]] && apply_mode light || apply_mode dark ;;
    *)
        echo "Usage: theme [toggle|dark|light|apply]" >&2
        exit 1
        ;;
esac
