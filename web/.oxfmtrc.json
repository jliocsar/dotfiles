{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortPackageJson": true,
  "ignorePatterns": ["**/dist", "**/node_modules", "**/public", "bun.lock"]
}
