{
  "$schema": "http://json.schemastore.org/package",
  "name": "web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@dotfiles/web' dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "effect-tsgo patch --oxlint",
    "deploy": "bun run --filter '@dotfiles/web' deploy"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.1",
    "@jliocsar/begone-slop": "^0.1.4",
    "@types/bun": "^1.3.14",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "alchemy@2.0.0-beta.77": "patches/alchemy@2.0.0-beta.77.patch"
  }
}
